{
  "name": "spoken",
  "version": "0.7.2",
  "description": "Obsidian plugin: speak into a note on phone or desktop and get clean text at the cursor, transcribed by Gemini under your own API key.",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dictation",
    "speech-to-text",
    "transcription",
    "gemini",
    "voice"
  ],
  "author": "Michael Hejazi (https://github.com/michaelhejazi)",
  "homepage": "https://github.com/michaelhejazi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelhejazi/spoken.git"
  },
  "bugs": {
    "url": "https://github.com/michaelhejazi/spoken/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "tsc -p test && vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "playground": "node design/playground/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
